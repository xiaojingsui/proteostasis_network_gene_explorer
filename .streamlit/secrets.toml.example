# Rename this file to secrets.toml for LOCAL testing (streamlit run app.py).
# On Streamlit Community Cloud, paste the [email] block into
# Manage app -> Settings -> Secrets instead.
[email]
resend_api_key = "re_your_api_key_here"     # from resend.com -> API Keys
recipient      = "pnannotation@gmail.com"
# sender is optional. Free Resend tier must use onboarding@resend.dev (the default).
# Once you verify a custom domain in Resend, set e.g. sender = "feedback@yourdomain.org"
# sender       = "onboarding@resend.dev"
